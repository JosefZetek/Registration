<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Registration.Views"
             x:Class="Registration.Views.AlignmentView">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="*">

            <StackPanel
                Orientation="Horizontal"
                Grid.Row="0"
                Margin="12">
                    <Image
                        Source="{SvgImage /Assets/Images/arrows-in-simple.svg}"
                        Width="40"
                        Height="40"
                        Margin="0,0,8,0"/>
                    <TextBlock
                        Text="Alignment Viewer"
                        VerticalAlignment="Center"
                        FontStyle="Italic"
                        FontSize="26"
                        FontWeight="SemiLight"
                        Padding="10"/>
            </StackPanel>

            <WrapPanel
                Grid.Row="1"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Margin="12">

                <views:IndicatorView
                    x:Name="IndicatorMicroMeta"
                    Text="Micro Meta Data"
                    Opacity="0.5"/>

                <views:IndicatorView
                    x:Name="IndicatorMicroRaw"
                    Text="Micro Raw Data"
                    Opacity="0.5"/>

                <views:IndicatorView
                    x:Name="IndicatorMacroMeta"
                    Text="Macro Meta Data"
                    Opacity="0.5"/>

                <views:IndicatorView
                    x:Name="IndicatorMacroRaw"
                    Text="Macro Raw Data"
                    Opacity="0.5"/>

                <views:IndicatorView
                    x:Name="IndicatorTransformation"
                    Text="Transformation"
                    Opacity="0.5"/>

            </WrapPanel>

            <TextBlock
                Grid.Row="2"
                Text="Micro Data"
                FontStyle="Italic"
                FontSize="24"
                FontWeight="Light"
                Margin="12"/>

            <WrapPanel
                Grid.Row="3"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <views:ButtonView
                    Text="Select Micro Meta Data"
                    Icon="{SvgImage /Assets/Images/file-mhd.svg}"
                    Click="OnSelectMicroMetaButton_Click"/>

                <views:ButtonView
                    Text="Select Micro Raw Data"
                    Icon="{SvgImage /Assets/Images/file-raw.svg}"
                    Click="OnSelectMicroRawButton_Click"/>

            </WrapPanel>

            <Separator Grid.Row="4" Margin="10"/>

            <TextBlock
                Grid.Row="5"
                Text="Macro Data"
                FontStyle="Italic"
                FontSize="24"
                FontWeight="Light"
                Margin="12"/>

            <WrapPanel
                Grid.Row="6"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <views:ButtonView
                    Text="Select Macro Meta Data"
                    Icon="{SvgImage /Assets/Images/file-mhd.svg}"
                    Click="OnSelectMacroMetaButton_Click"/>

                <views:ButtonView
                    Text="Select Macro Raw Data"
                    Icon="{SvgImage /Assets/Images/file-raw.svg}"
                    Click="OnSelectMacroRawButton_Click"/>

            </WrapPanel>

            <Separator Grid.Row="7" Margin="10"/>

            <TextBlock
                Grid.Row="8"
                Text="Transformation"
                FontStyle="Italic"
                FontSize="24"
                FontWeight="Light"
                Margin="12"/>

            <WrapPanel
                Grid.Row="9"
                HorizontalAlignment="Center"
                Orientation="Horizontal">

                <views:ButtonView
                    Text="Select Transformation (.txt)"
                    Icon="{SvgImage /Assets/Images/transformation.svg}"
                    Click="OnSelectTransformationButton_Click"/>

            </WrapPanel>

            <WrapPanel
                Grid.Row="10"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Margin="0,10,0,0">

                <views:ButtonView
                    Text="Show Alignment"
                    Icon="{SvgImage /Assets/Images/play.svg}"
                    Click="OnShowButton_Click"/>

                <views:ButtonView
                    Text="Clear Selection"
                    Icon="{SvgImage /Assets/Images/clear.svg}"
                    Click="OnClearButton_Click"/>

            </WrapPanel>

        </Grid>
    </ScrollViewer>
</UserControl>
