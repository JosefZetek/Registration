<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Registration.Views"
             x:Class="Registration.Views.ProgressView">

    <StackPanel Orientation="Vertical">
        <TextBlock>Number of tests</TextBlock>
        <ProgressBar x:Name="NumberOfTests"></ProgressBar>
        <TextBlock>Feature Computation</TextBlock>
        <ProgressBar x:Name="FeatureComputation"></ProgressBar>        
    </StackPanel>
    
</UserControl>