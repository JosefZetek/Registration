<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Registration.Views.ButtonView">

    <Border
        Background="#EEE"
        BoxShadow="2 2 2 2 Gray"
        Height="50"
        CornerRadius="25"
        Margin="5">
        
        <Button
            x:Name="PART_Button"
            Background="Transparent"
            BorderThickness="0"
            Height="50"
            CornerRadius="25"
            Margin="0"
            Cursor="Hand">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image x:Name="PART_Icon"
                       Width="30" Height="30"
                       Margin="10,0,0,0"/>

                <TextBlock x:Name="PART_Text"
                           VerticalAlignment="Center"
                           Margin="10"/>
            </StackPanel>
        </Button>
    </Border>
</UserControl>